datasource db {
  provider = "postgresql"
  url      = "postgresql://Xeno:Xeno@XenoDB:5432/Xeno"
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

enum entityType {
  USER
  GUILD
}

enum channelType {
  TEXT
  VOICE
}

enum ArchiveMode {
  LEAVE
  INACTIVE
  MANUAL
}

model Entities {
  ID             BigInt           @id @unique
  type           entityType
  prefix         String           @default("x-")
  Blacklist      Blacklist?
  UserChannels   UserChannels[]
  ErrorReminders ErrorReminders[] @relation("ErrorReminders")
  Pastes         Pastes[]
}

model Blacklist {
  entityID         BigInt    @id @unique
  entity           Entities  @relation(fields: [entityID], references: [ID])
  reason           String?
  blacklistedOn    DateTime  @default(now())
  blacklistedUntil DateTime?
  blacklistActive  Boolean   @default(true)
}

model UserChannels {
  channelID   BigInt       @id @unique
  ownerID     BigInt
  entity      Entities     @relation(fields: [ownerID], references: [ID])
  archiveMode ArchiveMode?
}

model Errors {
  ID             Int              @id @unique @default(autoincrement())
  errorName      String
  traceback      String
  userID         BigInt
  guildID        BigInt?
  errorTime      DateTime         @default(now())
  errorMessageID BigInt
  fixed          Boolean          @default(false)
  command        String?
  ErrorReminders ErrorReminders[]
  errorPasteID   String           
  errorPaste     Pastes           @relation(fields: [errorPasteID], references: [ID])
}

model ErrorReminders {
  error   Errors   @relation(fields: [errorID], references: [ID])
  errorID Int
  userID  BigInt
  users   Entities @relation("ErrorReminders", fields: [userID], references: [ID])

  @@id([errorID, userID])
}

model Pastes {
  ID        String   @id
  createdAt DateTime @default(now())
  ownerID   BigInt
  entity    Entities @relation(fields: [ownerID], references: [ID])
  safety    String
  Errors    Errors[]
}
